{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensource-elixpo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "opensource.elixpo.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://opensource.elixpo.com",
    "NEXT_PUBLIC_ACCOUNTS_URL": "https://accounts.elixpo.com",
    "NEXT_PUBLIC_GITHUB_REPOSITORY": "https://github.com/elixpo/opensource"
  },
  "secrets": {
    "required": [
      "NEXT_PUBLIC_ELIXPO_CLIENT_ID",
      "ELIXPO_CLIENT_SECRET",
      "GITHUB_APP_ID",
      "GITHUB_APP_PRIVATE_KEY",
      "GITHUB_WEBHOOK_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opensource-elixpo",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "workers/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    },
    {
      "binding": "RATE_LIMITS",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_OUTBOUND_QUEUE",
        "queue": "elixpo-email-outbound"
      }
    ]
  }
}
